# Global PyMOL display defaults. Function commands live in ~/.pymolrc.py.
bg_color white
set ambient, 0.25
set stick_radius, 0.25
set sphere_scale, 0.3
set ignore_pdb_segi, on
set two_sided_lighting, 1
set ray_shadow, off
set retain_order, 1
set pdb_retain_ids, on
set seq_view, on
set display_scale_factor, 0.5
set editor_auto_measure, off

# Ray tracing and anti-aliasing.
set ray_trace_mode, 0
set ray_trace_gain, 0.30
set ray_trace_color, black
set ray_interior_color, grey20

# Keep manual distance measurements close to PyMOL defaults.
set dash_color, yellow
set dash_radius, 0.03
set dash_gap, 0.35
set label_color, yellow
