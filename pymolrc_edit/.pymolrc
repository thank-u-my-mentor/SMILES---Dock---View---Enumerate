from pymol import cmd

cmd.set("bg_rgb", [1.0, 1.0, 1.0])
cmd.set("ambient", 0.25)
cmd.set("stick_radius", 0.25)
cmd.set("sphere_scale", 0.3)
cmd.set("ignore_pdb_segi", "on")
cmd.set("two_sided_lighting", 1)
cmd.set("ray_shadow", "off")
cmd.set("retain_order", 1)
cmd.set("pdb_retain_ids", "on")
cmd.set("seq_view", "on")
cmd.set("display_scale_factor", 0.5)
cmd.set("editor_auto_measure", "off")

cmd.set("ray_trace_mode", 0)
cmd.set("ray_trace_gain", 0.30)
cmd.set("ray_trace_color", "black")
cmd.set("ray_interior_color", "grey20")

# Keep manual measurements close to PyMOL defaults: yellow dashes with labels.
cmd.set("dash_color", "yellow")
cmd.set("dash_radius", 0.05)
cmd.set("dash_gap", 0.35)
cmd.set("label_color", "yellow")

# Do not force hetero groups such as phosphate into sphere display on load.
cmd.set("auto_show_spheres", "off")
cmd.set("auto_show_sticks", "on")
